# ===========================================
# Bazm-e-Adab — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DATABASE_URL=postgresql://bazm_user:bazm_dev_password@localhost:5432/bazm_adab
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://:bazm_redis_dev@localhost:6379

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=bazm_meili_dev_key

# --- Auth / JWT ---
JWT_PRIVATE_KEY=your-rsa-private-key-here
JWT_PUBLIC_KEY=your-rsa-public-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Session Secret (for iron-session) ---
SESSION_SECRET=a-very-long-random-string-at-least-32-characters

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@bazmeadab.com

# --- App ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- File Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bazm-uploads
S3_REGION=us-east-1
